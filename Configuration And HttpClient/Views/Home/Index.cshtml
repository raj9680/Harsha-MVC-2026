﻿@{
 ViewBag.Title = "Home";
}

<div class="box trading-panel">

 <div class="flex trading-panel-flex">

  <div id="stock-price-panel">

   <div class="stock">
    <h1 class="stock-title">Symbol</h1>

    <table>
     <tbody>
      <tr>
       <td>Current:</td>
       <th><small>$</small> <span class="price">Price</span></th>
      </tr>

      <tr>
       <td>High:</td>
       <th><small>$</small> <span class="price">Highest Price</span></th>
      </tr>

      <tr>
       <td>Low:</td>
       <th><small>$</small> <span class="price">Lowest Price</span></th>
      </tr>

      <tr>
       <td>Open:</td>
       <th><small>$</small> <span class="price">Open Price</span></th>
      </tr>
     </tbody>
    </table>
   </div>

  </div>
 </div>
</div>