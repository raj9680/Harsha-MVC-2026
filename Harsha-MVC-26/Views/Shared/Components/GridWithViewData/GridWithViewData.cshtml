<div class="box">
    <h3>@ViewBag.Grid.GridTitle</h3>
    <table class="table w-100">
        <thead>
            <tr>
                <th>Name</th>
                <th>D.O.B</th>
                <th>Gender</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Person item in ViewBag.Grid.Persons)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.DateOfBirth</td>
                    <td>@item.PersonGender</td>
                </tr>
            }
        </tbody>
    </table>
</div>


