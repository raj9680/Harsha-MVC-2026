@{
    ViewData["Title"] = "Home - Asp Net Core";
}

<h1>Home</h1><br />

<div class="box">

@*
Partial View 1: Normal Partial View *@
<p>Normal Partial View</p>
<partial name="_ListPartialView"></partial>




@* 
Partial View 2: Here data from controller is coming different but we have updated the 
ViewData in View itself and passed the same in partial view with attr: view-data.

@{
    var myViewData = new ViewDataDictionary(ViewData);
    myViewData["ListTitle"] = "Countries";
    myViewData["ListItems"] = new List<string>()
    {
        "USA",
        "Canada",
        "Japan",
        "India",
        "Germany"
    };
}

<p>Updated Partial View from View</p>
<partial name="_ListPartialView" view-data="myViewData"></partial>
*@



@*
Partial View 3: Strongly Typed Partial View

    @{
    ListModel listModel = new ListModel();
    listModel.ListTitle = "Strongly Typed Partial View Title";
    listModel.ListItems = new List<string>()
    {
    "USA",
    "India",
    "Australia"
    };
    }

    <p>Strongly Typed Partial View</p>
    <partial name="_ListPartialView" model="listModel"></partial>
*@



@*Partial View 4: Asynchronous Partial View

<button class="button blue-back" type="button" id="button-load">
    Load Programming Languages
</button>

<div class="box programming-languages-content"></div>

<script>

    document.querySelector("#button-load").addEventListener("click", async function () {
        var response = await fetch("partial-view-result");
        var languages = await response.text();
        document.querySelector(".programming-languages-content").innerHTML = languages;
    });

</script>

End Async PV*@


@* <h3>ListTitle in View: @ViewData["ListTitle"]</h3> *@
</div>