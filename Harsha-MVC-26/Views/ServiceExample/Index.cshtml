@model List<string>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Home";
}

<div class="box">
<ul class="list">
@foreach (var item in Model)
{
    <li>@item</li>
}
</ul>
</div>

<div class="box">
    <ul>
        <li>@ViewBag.Guid1</li>
        <li>@ViewBag.Guid2</li>
        <li>@ViewBag.Guid3</li>
    </ul>
</div>