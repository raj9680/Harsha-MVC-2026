@using ServiceContracts.DTO.Enums
@model PersonResponse
﻿@{
    ViewBag.Title = "Delete Person";
}

<a asp-controller="Person" asp-action="Index" class="link-hover">Back to Persons List</a>
<h2>Delete Person</h2>

<div class="w-50">
    <form asp-controller="Person" asp-action="Delete" method="post">

        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="PersonName" class="form-label pt">Person Name</label>
            </div>
            <div class="flex-1">
                <input asp-for="PersonName" value="@Model.PersonName" class="form-input" disabled="disabled" />
                <input type="hidden" asp-for="PersonID" />
                <span asp-validation-for="PersonName" class="text-red"></span>
            </div>
        </div>

        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="Email" class="form-label pt">Email</label>
            </div>
            <div class="flex-1">
                <input asp-for="Email" value="@Model.Email" class="form-input" disabled="disabled" />
                <span asp-validation-for="Email" class="text-red"></span>
            </div>
        </div>


        @*Submit*@
        <div class="form-field flex">
            <div class="w-25"></div>
            <div class="flex-1">
                <button class="button button-red-back">Delete</button>
                <div asp-validation-summary="All"></div>
                @if (ViewBag.Errors != null)
                {
                    <div class="text-red ml">
                        <ul>
                            @foreach (string error in ViewBag.Errors)
                            {
                                <li class="ml">@error</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </form>
</div>